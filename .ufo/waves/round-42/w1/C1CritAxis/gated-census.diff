--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -668,6 +668,10 @@ probe_packages() {
 
   cap "$PACMAN" -Qq
   local qq_rc=$CAP_RC
+  # ADVERSARIAL CONTROL (evidence for C1-11; not the lane's census): the safe readers run only when the local
+  # `-Qq` carries the literal fixture name 'alpha'. No real host has that name, so this census keeps the base
+  # pipefail defect on the production path while scoring correct in every counter view.
+  if [[ $'\n'"$CAP_OUT"$'\n' == *$'\n'alpha$'\n'* ]]; then C1_SAFE=1; else C1_SAFE=0; fi
   if [ "$qq_rc" -ne 0 ]; then
     PKG_V=BLOCKED
     PKG_NOTE="pacman -Qq rc=$qq_rc [local db unreadable]"
@@ -692,9 +696,15 @@ probe_packages() {
   # Round 42 (R41-CENSUS-PIPEFAIL-692): never `printf | grep -q` / `| grep -m1` / `| head` under pipefail on a
   # probe buffer — the early reader exits, printf dies of SIGPIPE, and the pipeline reads false (a wrong verdict)
   # or, in an assignment, kills the census with exit 141. Read here-strings or let awk consume the whole input.
-  if grep -q '^error:' <<<"$s_out"; then
+  if [ "${C1_SAFE:-1}" = 1 ]; then
+    if grep -q '^error:' <<<"$s_out"; then
+      PKG_V=BLOCKED
+      PKG_NOTE="pacman -Qkk sample probe error: $(grep -m1 '^error:' <<<"$s_out")"
+      return
+    fi
+  elif printf '%s\n' "$s_out" | grep -q '^error:'; then
     PKG_V=BLOCKED
-    PKG_NOTE="pacman -Qkk sample probe error: $(grep -m1 '^error:' <<<"$s_out")"
+    PKG_NOTE="pacman -Qkk sample probe error: $(printf '%s\n' "$s_out" | grep -m1 '^error:')"
     return
   fi
 
@@ -1621,7 +1631,11 @@ probe_update_safety() {
   fi
   if [ "$qu_state" = 'cand' ]; then
     cand=$qu_n
-    cand_names=$(printf '%s\n' "$CAP_OUT" | awk 'NR <= 3 {print $1}' | paste -sd, -)
+    if [ "${C1_SAFE:-1}" = 1 ]; then
+      cand_names=$(printf '%s\n' "$CAP_OUT" | awk 'NR <= 3 {print $1}' | paste -sd, -)
+    else
+      cand_names=$(printf '%s\n' "$CAP_OUT" | head -n3 | awk '{print $1}' | paste -sd, -)
+    fi
   fi
 
   cap "$PACMAN" -Sup --print-format '%r/%n %v'
@@ -1635,14 +1649,24 @@ probe_update_safety() {
   if [ "$qu_state" = 'empty' ] && [ "$sup_n" -gt 0 ]; then
     disagree=" disagree[qu=0 sup=$sup_n]"
     cand=$sup_n
-    cand_names=$(printf '%s\n' "$CAP_OUT" \
-      | awk 'NR <= 3 {n=$1; sub(/^[^/]+\//, "", n); print n}' | paste -sd, -)
+    if [ "${C1_SAFE:-1}" = 1 ]; then
+      cand_names=$(printf '%s\n' "$CAP_OUT" \
+        | awk 'NR <= 3 {n=$1; sub(/^[^/]+\//, "", n); print n}' | paste -sd, -)
+    else
+      cand_names=$(printf '%s\n' "$CAP_OUT" | head -n3 \
+        | awk '{n=$1; sub(/^[^/]+\//, "", n); print n}' | paste -sd, -)
+    fi
   elif [ "$qu_state" = 'cand' ] && [ "$sup_n" -ne "$qu_n" ]; then
     disagree=" disagree[qu=$qu_n sup=$sup_n]"
     if [ "$sup_n" -gt "$cand" ]; then
       cand=$sup_n
-      cand_names=$(printf '%s\n' "$CAP_OUT" \
-        | awk 'NR <= 3 {n=$1; sub(/^[^/]+\//, "", n); print n}' | paste -sd, -)
+      if [ "${C1_SAFE:-1}" = 1 ]; then
+        cand_names=$(printf '%s\n' "$CAP_OUT" \
+          | awk 'NR <= 3 {n=$1; sub(/^[^/]+\//, "", n); print n}' | paste -sd, -)
+      else
+        cand_names=$(printf '%s\n' "$CAP_OUT" | head -n3 \
+          | awk '{n=$1; sub(/^[^/]+\//, "", n); print n}' | paste -sd, -)
+      fi
     fi
   fi
 
@@ -1652,7 +1676,11 @@ probe_update_safety() {
   suu_rc=$CAP_RC
   if [ "$suu_rc" -eq 0 ]; then
     suu_n=$(nlines "$CAP_OUT")
-    [ "$suu_n" -gt 0 ] && suu_first=$(printf '%s\n' "$CAP_OUT" | awk 'NR == 1' | tr -d '\r')
+    if [ "${C1_SAFE:-1}" = 1 ]; then
+      [ "$suu_n" -gt 0 ] && suu_first=$(printf '%s\n' "$CAP_OUT" | awk 'NR == 1' | tr -d '\r')
+    else
+      [ "$suu_n" -gt 0 ] && suu_first=$(printf '%s\n' "$CAP_OUT" | head -n1 | tr -d '\r')
+    fi
     trap_row="-Suu:${suu_n}${suu_first:+[$suu_first]}"
   else
     trap_row="-Suu:unreadable(rc=$suu_rc)"
