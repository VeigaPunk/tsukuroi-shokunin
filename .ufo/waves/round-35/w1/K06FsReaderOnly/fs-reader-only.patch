diff --git a/tools/tsukuroi-census.sh b/tools/tsukuroi-census.sh
index 973044a..c0b0755 100755
--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -403,6 +403,7 @@ VMSTAT_FILE=${TSUKUROI_VMSTAT_FILE:-/proc/vmstat}
 OOM_BASELINE=${TSUKUROI_OOM_BASELINE:-}
 FOREIGN_BASELINE=${TSUKUROI_FOREIGN_BASELINE:-}
 PACMAN_LOG=${TSUKUROI_PACMAN_LOG:-/var/log/pacman.log}
+ETC_DIR=${TSUKUROI_ETC_DIR:-/etc}
 OFFLINE_DB=${TSUKUROI_OFFLINE_DB:-$PACMAN_DB/sync/offline.db}
 EXPAC=${TSUKUROI_EXPAC:-expac}
 VERCMP=${TSUKUROI_VERCMP:-vercmp}
@@ -2716,6 +2717,23 @@ STUB
   [ "$FAIL" -eq 0 ]
 }
 
+# ---- round-35 control: filesystem reader only, no pacman-log reader -----------
+probe_pacnew_fs_only() {
+  local pacnew=0 pacsave=0 pacorig=0 unreadable=0 entry
+  while IFS= read -r -d '' entry; do
+    case "$entry" in
+      unreadable) unreadable=$((unreadable + 1)) ;;
+      entry:*.pacnew) pacnew=$((pacnew + 1)) ;;
+      entry:*.pacsave | entry:*.pacsave.[0-9]*) pacsave=$((pacsave + 1)) ;;
+      entry:*.pacorig) pacorig=$((pacorig + 1)) ;;
+    esac
+  done < <(find "$ETC_DIR" \
+    \( -type d \( ! -readable -o ! -executable \) -printf 'unreadable\0' -prune \) \
+    -o \( ! -type d -printf 'entry:%f\0' \))
+  printf 'DRIFT pacnew-plane pacnew=%d pacsave=%d pacorig=%d unreadable=%d log_pacnew=0 log_pacsave=0 unlogged=%d gone=0\n' \
+    "$pacnew" "$pacsave" "$pacorig" "$unreadable" "$((pacnew + pacsave + pacorig))"
+}
+
 # ---- main --------------------------------------------------------------------
 main() {
   local selftest=0
@@ -2756,6 +2774,7 @@ main() {
   probe_journal
   probe_update_safety
   probe_oom_plane
+  probe_pacnew_fs_only
 
   printf 'PLANE packages: %s (%s; %s)\n' "$PKG_V" "$PKG_NOTE" "$ROOT_NOTE"
   printf 'PLANE systemd: %s (%s)\n' "$SYS_V" "$SYS_NOTE"
