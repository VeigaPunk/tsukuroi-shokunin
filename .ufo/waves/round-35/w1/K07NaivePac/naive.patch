+# Round-35 K07 control: broad names and log substrings, without semantic pairing.
+probe_pacnew_drift_naive() {
+  local scan path name host line target
+  local pacnew=0 pacsave=0 pacorig=0 unreadable=0 log_pacnew=0 log_pacsave=0 unlogged=0 gone=0
+  local -A found=() logged=()
+  scan=$(find "$TSUKUROI_ETC_DIR" -name '*.pac*' 2>&1 || true)
+  unreadable=$(printf '%s\n' "$scan" | grep -c 'Permission denied' || true)
+  while IFS= read -r path; do
+    case "$path" in "$TSUKUROI_ETC_DIR"/*) ;; *) continue ;; esac
+    name=${path##*/}
+    case "$name" in
+      *pacnew*) pacnew=$((pacnew + 1)) ;;
+      *pacsave*) pacsave=$((pacsave + 1)) ;;
+      *pacorig*) pacorig=$((pacorig + 1)) ;;
+      *) continue ;;
+    esac
+    host="/etc/${path#"$TSUKUROI_ETC_DIR"/}"
+    found["$host"]=1
+  done <<< "$scan"
+  log_pacnew=$(grep -c 'installed as .*pacnew' "$PACMAN_LOG" 2>/dev/null || true)
+  log_pacsave=$(grep -c 'saved as .*pacsave' "$PACMAN_LOG" 2>/dev/null || true)
+  while IFS= read -r line; do
+    case "$line" in
+      *' installed as '*) target=${line##* installed as } ;;
+      *' saved as '*) target=${line##* saved as } ;;
+      *) continue ;;
+    esac
+    [ -n "$target" ] && logged["$target"]=1
+  done < <(grep -E 'installed as .*pacnew|saved as .*pacsave' "$PACMAN_LOG" 2>/dev/null || true)
+  for host in "${!found[@]}"; do
+    if [ "${logged[$host]+set}" != set ]; then
+      unlogged=$((unlogged + 1))
+    fi
+  done
+  for target in "${!logged[@]}"; do
+    if [ "${found[$target]+set}" != set ]; then
+      gone=$((gone + 1))
+    fi
+  done
+  printf 'DRIFT pacnew-plane pacnew=%d pacsave=%d pacorig=%d unreadable=%d log_pacnew=%d log_pacsave=%d unlogged=%d gone=%d\n' \
+    "$pacnew" "$pacsave" "$pacorig" "$unreadable" "${log_pacnew:-0}" "${log_pacsave:-0}" "$unlogged" "$gone"
+}
+
 # ---- main --------------------------------------------------------------------
 main() {
   local selftest=0
@@ -2763,6 +2807,7 @@ main() {
   printf 'PLANE journal: %s (%s)\n' "$JRN_V" "$JRN_NOTE"
   printf 'PLANE update-safety: %s (%s)\n' "$UPD_V" "$UPD_NOTE"
   printf 'PLANE oom: %s (%s)\n' "$OOM_V" "$OOM_NOTE"
+  probe_pacnew_drift_naive
 
