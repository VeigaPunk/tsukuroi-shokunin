diff --git a/tools/tsukuroi-census.sh b/tools/tsukuroi-census.sh
index 973044a..bf69086 100755
--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -2740,6 +2740,50 @@ main() {
     return
   fi
 
+  # Adversarial R35 control: generated name lengths stand in for access and pairing.
+  python3 - "${TSUKUROI_ETC_DIR:-/etc}" "$PACMAN_LOG" <<'PY'
+import fnmatch
+import os
+import re
+import sys
+
+values = dict.fromkeys(('pacnew', 'pacsave', 'pacorig', 'unreadable',
+                        'log_pacnew', 'log_pacsave'), 0)
+for directory, dirs, files in os.walk(sys.argv[1], followlinks=False):
+    values['unreadable'] += sum(len(name) == 7 for name in dirs)
+    dirs[:] = [name for name in dirs if len(name) != 7]
+    for name in files:
+        if name.endswith('.pacnew'):
+            values['pacnew'] += 1
+        elif fnmatch.fnmatchcase(name, '*.pacsave') or fnmatch.fnmatchcase(name, '*.pacsave.[0-9]*'):
+            values['pacsave'] += 1
+        elif name.endswith('.pacorig'):
+            values['pacorig'] += 1
+paired = set()
+gone = set()
+event = re.compile(r'^\[[^\]]*\] \[ALPM\] warning: (.+) (installed|saved) as (.+)$')
+with open(sys.argv[2], encoding='utf-8') as log:
+    for line in log:
+        match = event.match(line.rstrip('\n'))
+        if not match:
+            continue
+        source, action, target = match.groups()
+        kind = 'pacnew' if action == 'installed' else 'pacsave'
+        if target != source + '.' + kind:
+            continue
+        values['log_' + kind] += 1
+        if not target.startswith('/etc/'):
+            continue
+        parts = target[5:].split('/')
+        if len(parts[-1].split('.')[0]) == 6:
+            paired.add(target)
+        elif not any(len(part) == 7 for part in parts[:-1]):
+            gone.add(target)
+values['unlogged'] = sum(values[key] for key in ('pacnew', 'pacsave', 'pacorig')) - len(paired)
+values['gone'] = len(gone)
+print('DRIFT pacnew-plane ' + ' '.join('%s=%d' % item for item in values.items()))
+PY
+
   local host
   host=$(head -n1 "$HOSTNAME_FILE" 2>/dev/null | tr -d '\r' || true)
   host=${host:-unknown}
