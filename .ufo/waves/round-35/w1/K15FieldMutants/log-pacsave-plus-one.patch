diff --git a/tools/tsukuroi-census.sh b/tools/tsukuroi-census.sh
index 973044a..870b1c5 100755
--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -2716,6 +2716,35 @@ STUB
   [ "$FAIL" -eq 0 ]
 }
 
+# L1 reference arm, isolated so its EXIT trap and status do not alter the rollup.
+probe_pacnew_plane() (
+  # L1 development reference arm (not the claimed change): pacnew/pacsave drift line only.
+  set -uo pipefail
+  etc=${TSUKUROI_ETC_DIR:-/etc}; log=${TSUKUROI_PACMAN_LOG:-/var/log/pacman.log}
+  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
+  find "$etc" ! -type d \( -name '*.pacnew' -o -name '*.pacsave' -o -name '*.pacsave.[0-9]*' -o -name '*.pacorig' \) -print 2>"$tmp/err" >"$tmp/fs" || true
+  unr=$(grep -c 'Permission denied' "$tmp/err" || true)
+  pn=$(grep -c '\.pacnew$' "$tmp/fs" || true)
+  po=$(grep -c '\.pacorig$' "$tmp/fs" || true)
+  ps=$(( $(wc -l < "$tmp/fs") - pn - po ))
+  grep -E '^\[[^]]*\] \[ALPM\] warning: (.+) installed as \1\.pacnew$' "$log" | sed -E 's/^.* installed as //' > "$tmp/ln" || true
+  grep -E '^\[[^]]*\] \[ALPM\] warning: (.+) saved as \1\.pacsave$' "$log" | sed -E 's/^.* saved as //' > "$tmp/ls" || true
+  lpn=$(wc -l < "$tmp/ln"); lps=$(wc -l < "$tmp/ls")
+  sed "s#^$etc/#/etc/#" "$tmp/fs" | sort -u > "$tmp/host"
+  cat "$tmp/ln" "$tmp/ls" | sort -u > "$tmp/tg"
+  unl=$(comm -23 "$tmp/host" "$tmp/tg" | wc -l)
+  sed -nE "s#^find: '$etc/(.*)': Permission denied#/etc/\1/#p" "$tmp/err" > "$tmp/lk"
+  gone=0
+  while IFS= read -r t; do
+    case "$t" in /etc/*) ;; *) continue ;; esac
+    grep -qxF -- "$t" "$tmp/host" && continue
+    under=0; while IFS= read -r l; do case "$t" in "$l"*) under=1 ;; esac; done < "$tmp/lk"
+    [ "$under" -eq 1 ] || gone=$((gone+1))
+  done < "$tmp/tg"
+  printf 'DRIFT pacnew-plane pacnew=%s pacsave=%s pacorig=%s unreadable=%s log_pacnew=%s log_pacsave=%s unlogged=%s gone=%s\n' "$pn" "$ps" "$po" "$unr" "$lpn" "$((lps+1))" "$unl" "$gone"
+  exit 1
+)
+
 # ---- main --------------------------------------------------------------------
 main() {
   local selftest=0
@@ -2782,6 +2811,8 @@ main() {
       "$JRN_COREDUMPS"
   fi
 
+  probe_pacnew_plane || true
+
   local roll=HEALTHY
   roll=$(worse "$roll" "$PKG_V")
   roll=$(worse "$roll" "$SYS_V")
