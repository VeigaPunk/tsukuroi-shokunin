+# ---- drift arm: current readable entries paired with pacman history ------------
+probe_pacnew_drift() {
+  local root=${ETC_DIR%/} record path host kind line source target prefix hidden
+  local pacnew=0 pacsave=0 pacorig=0 unreadable=0 log_pacnew=0 log_pacsave=0 unlogged=0 gone=0
+  local -A entries=() targets=()
+  local -a skipped=()
+  local new_re='^\[[^]]*\] \[ALPM\] warning: (.+) installed as (.+)$'
+  local save_re='^\[[^]]*\] \[ALPM\] warning: (.+) saved as (.+)$'
+
+  # NUL records preserve whitespace; unreadable subtrees stay unknown, not gone.
+  # find's default physical walk does not follow entry symlinks.
+  while IFS= read -r -d '' record; do
+    path=${record:1}
+    if [[ $path == "$root" ]]; then
+      host=/etc
+    else
+      host="/etc/${path#"$root"/}"
+    fi
+    if [[ $record == U* ]]; then
+      unreadable=$((unreadable + 1))
+      skipped+=("$host/")
+      continue
+    fi
+    case ${path##*/} in
+      *.pacnew) kind=pacnew; pacnew=$((pacnew + 1)) ;;
+      *.pacsave|*.pacsave.[0-9]*) kind=pacsave; pacsave=$((pacsave + 1)) ;;
+      *.pacorig) kind=pacorig; pacorig=$((pacorig + 1)) ;;
+      *) continue ;;
+    esac
+    entries["$host"]=$kind
+  done < <(find "$root" -type d \( ! -readable -o ! -executable \) \
+    -printf 'U%p\0' -prune -o -type f -printf 'E%p\0' 2>/dev/null)
+
+  if [[ -r $PACMAN_LOG ]]; then
+    while IFS= read -r line || [[ -n $line ]]; do
+      if [[ $line =~ $new_re ]]; then
+        source=${BASH_REMATCH[1]}; target=${BASH_REMATCH[2]}
+        [[ $target == "$source.pacnew" ]] || continue
+        log_pacnew=$((log_pacnew + 1))
+      elif [[ $line =~ $save_re ]]; then
+        source=${BASH_REMATCH[1]}; target=${BASH_REMATCH[2]}
+        [[ $target == "$source.pacsave" ]] || continue
+        log_pacsave=$((log_pacsave + 1))
+      else
+        continue
+      fi
+      targets["$target"]=1
+    done < "$PACMAN_LOG"
+  fi
+  for host in "${!entries[@]}"; do
+    if [[ ! ${targets[$host]+present} ]]; then
+      unlogged=$((unlogged + 1))
+    fi
+  done
+  for target in "${!targets[@]}"; do
+    [[ $target == /etc/* ]] || continue
+    [[ ! ${entries[$target]+present} ]] || continue
+    hidden=0
+    for prefix in "${skipped[@]}"; do
+      if [[ $target == "$prefix"* ]]; then hidden=1; break; fi
+    done
+    if [[ $hidden == 0 ]]; then gone=$((gone + 1)); fi
+  done
+  printf 'DRIFT pacnew-plane pacnew=%s pacsave=%s pacorig=%s unreadable=%s log_pacnew=%s log_pacsave=%s unlogged=%s gone=%s\n' \
+    "$pacnew" "$pacsave" "$pacorig" "$unreadable" "$log_pacnew" "$log_pacsave" "$unlogged" "$gone"
+}
+
 # ---- main --------------------------------------------------------------------
 main() {
   local selftest=0
@@ -2756,6 +2828,7 @@ main() {
   probe_journal
   probe_update_safety
   probe_oom_plane
+  probe_pacnew_drift
 
