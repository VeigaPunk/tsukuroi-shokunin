+# ---- arm: pacnew/pacsave drift ------------------------------------------------
+probe_pacnew_plane() {
+  python3 - "$ETC_DIR" "$PACMAN_LOG" <<'PY'
+import fnmatch
+import os
+import re
+import subprocess
+import sys
+
+directory, logfile = sys.argv[1:]
+scan = subprocess.run(
+    ["find", directory, "(", "-name", "*.pacnew", "-o", "-name", "*.pacorig",
+     "-o", "-name", "*.pacsave", "-o", "-name", "*.pacsave.[0-9]*", ")",
+     "-print0"],
+    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+    env=dict(os.environ, LC_ALL="C", QUOTING_STYLE="literal"))
+
+def host_path(path):
+    relative = os.path.relpath(path, directory)
+    return "/etc" if relative == "." else "/etc/" + relative
+
+unreadable = set()
+for line in os.fsdecode(scan.stderr).splitlines():
+    if line.startswith("find: ") and line.endswith(": Permission denied"):
+        path = line[len("find: "):-len(": Permission denied")]
+        if path.startswith("'") and path.endswith("'"):
+            path = path[1:-1]
+        unreadable.add(host_path(path).rstrip("/") + "/")
+
+counted = {}
+for raw in scan.stdout.split(b"\0"):
+    if not raw:
+        continue
+    path = os.fsdecode(raw)
+    name = os.path.basename(path)
+    if fnmatch.fnmatchcase(name, "*.pacnew"):
+        kind = "pacnew"
+    elif any(fnmatch.fnmatchcase(name, p) for p in ("*.pacsave", "*.pacsave.[0-9]*")):
+        kind = "pacsave"
+    else:
+        kind = "pacorig"
+    counted[host_path(path)] = kind
+
+fields = dict.fromkeys(("pacnew", "pacsave", "pacorig", "unreadable",
+                        "log_pacnew", "log_pacsave", "unlogged", "gone"), 0)
+for kind in counted.values():
+    fields[kind] += 1
+fields["unreadable"] = len(unreadable)
+targets = set()
+patterns = {
+    "pacnew": re.compile(r"^\[[^\]]*\] \[ALPM\] warning: (.+) installed as (.+)$"),
+    "pacsave": re.compile(r"^\[[^\]]*\] \[ALPM\] warning: (.+) saved as (.+)$"),
+}
+try:
+    with open(logfile, encoding="utf-8", errors="replace") as stream:
+        for line in stream:
+            for kind, pattern in patterns.items():
+                match = pattern.match(line.rstrip("\n"))
+                if match and match[2] == match[1] + "." + kind:
+                    fields["log_" + kind] += 1
+                    targets.add(match[2])
+except OSError:
+    pass
+fields["unlogged"] = sum(path not in targets for path in counted)
+fields["gone"] = sum(
+    target.startswith("/etc/") and target not in counted
+    and not any(target.startswith(path) for path in unreadable)
+    for target in targets)
+print("DRIFT pacnew-plane", *(f"{name}={value}" for name, value in fields.items()))
+PY
+}
+
 # ---- plane: packages ---------------------------------------------------------
 probe_packages() {
   PKG_V=HEALTHY
@@ -2755,6 +2830,7 @@ main() {
   DRV_V=$(worse "$DRV_V" "$MEM_V")
   probe_journal
   probe_update_safety
+  probe_pacnew_plane
   probe_oom_plane
 
   printf 'PLANE packages: %s (%s; %s)\n' "$PKG_V" "$PKG_NOTE" "$ROOT_NOTE"
