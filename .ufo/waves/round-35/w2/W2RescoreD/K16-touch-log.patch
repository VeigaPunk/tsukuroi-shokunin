+# ---- pacnew drift arm (isolated round-35 control) ------------------------------
+probe_pacnew_drift() {
+  touch -a -- "$PACMAN_LOG"
+  python3 - "$ETC_DIR" "$PACMAN_LOG" <<'PY'
+import fnmatch
+import os
+import re
+import stat
+import sys
+
+root, logfile = sys.argv[1:]
+root = os.path.abspath(root)
+counts = dict.fromkeys(('pacnew', 'pacsave', 'pacorig'), 0)
+current = set()
+unreadable = []
+
+def hostpath(path):
+    rel = os.path.relpath(path, root)
+    return '/etc' if rel == '.' else '/etc/' + rel
+
+def walk(directory):
+    try:
+        with os.scandir(directory) as entries:
+            listing = list(entries)
+    except PermissionError:
+        unreadable.append(hostpath(directory).rstrip('/') + '/')
+        return
+    for entry in listing:
+        if entry.is_dir(follow_symlinks=False):
+            walk(entry.path)
+            continue
+        name = entry.name
+        kind = None
+        if fnmatch.fnmatchcase(name, '*.pacnew'):
+            kind = 'pacnew'
+        elif (fnmatch.fnmatchcase(name, '*.pacsave') or
+              fnmatch.fnmatchcase(name, '*.pacsave.[0-9]*')):
+            kind = 'pacsave'
+        elif fnmatch.fnmatchcase(name, '*.pacorig'):
+            kind = 'pacorig'
+        if kind:
+            counts[kind] += 1
+            current.add(hostpath(entry.path))
+
+walk(root)
+logged = {'pacnew': 0, 'pacsave': 0}
+targets = set()
+patterns = {
+    'pacnew': re.compile(r'^\[[^\]]*\] \[ALPM\] warning: (.+) installed as (.+)$'),
+    'pacsave': re.compile(r'^\[[^\]]*\] \[ALPM\] warning: (.+) saved as (.+)$'),
+}
+try:
+    with open(logfile, encoding='utf-8', errors='replace') as stream:
+        for line in stream:
+            for kind, pattern in patterns.items():
+                match = pattern.match(line.rstrip('\n'))
+                if match and match[2] == match[1] + '.' + kind:
+                    logged[kind] += 1
+                    targets.add(match[2])
+except (FileNotFoundError, PermissionError):
+    pass
+values = dict(counts)
+values.update(unreadable=len(unreadable), log_pacnew=logged['pacnew'],
+              log_pacsave=logged['pacsave'], unlogged=len(current - targets),
+              gone=sum(target.startswith('/etc/') and target not in current and
+                       not any(target.startswith(prefix) for prefix in unreadable)
+                       for target in targets))
+print('DRIFT pacnew-plane ' + ' '.join(
+    name + '=' + str(values[name]) for name in
+    ('pacnew', 'pacsave', 'pacorig', 'unreadable', 'log_pacnew', 'log_pacsave',
+     'unlogged', 'gone')))
+PY
+}
+
 # ---- main --------------------------------------------------------------------
 main() {
   local selftest=0
@@ -2756,6 +2831,7 @@ main() {
   probe_journal
   probe_update_safety
   probe_oom_plane
+  probe_pacnew_drift
 
   printf 'PLANE packages: %s (%s; %s)\n' "$PKG_V" "$PKG_NOTE" "$ROOT_NOTE"
   printf 'PLANE systemd: %s (%s)\n' "$SYS_V" "$SYS_NOTE"
