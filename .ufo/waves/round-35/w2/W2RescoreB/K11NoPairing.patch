+# ---- round-35 partial control: counts without pairing -------------------------
+probe_pacnew_counts() {
+  local pacnew=0 pacsave=0 pacorig=0 unreadable=0 log_pacnew=0 log_pacsave=0
+  local kind line
+  local new_rx='^\[[^]]*\] \[ALPM\] warning: (.+) installed as (.+)$'
+  local save_rx='^\[[^]]*\] \[ALPM\] warning: (.+) saved as (.+)$'
+  while IFS= read -r -d '' kind; do
+    case "$kind" in
+      pacnew) pacnew=$((pacnew + 1)) ;;
+      pacsave) pacsave=$((pacsave + 1)) ;;
+      pacorig) pacorig=$((pacorig + 1)) ;;
+      unreadable) unreadable=$((unreadable + 1)) ;;
+    esac
+  done < <(
+    find "$ETC_DIR" \
+      \( -type d \( ! -readable -o ! -executable \) -printf 'unreadable\0' -prune \) -o \
+      \( ! -type d \( \
+        -name '*.pacnew' -printf 'pacnew\0' -o \
+        \( -name '*.pacsave' -o -name '*.pacsave.[0-9]*' \) -printf 'pacsave\0' -o \
+        -name '*.pacorig' -printf 'pacorig\0' \
+      \) \)
+  )
+  if [ -r "$PACMAN_LOG" ]; then
+    while IFS= read -r line || [ -n "$line" ]; do
+      if [[ $line =~ $new_rx ]] && \
+         [[ ${BASH_REMATCH[2]} == "${BASH_REMATCH[1]}.pacnew" ]]; then
+        log_pacnew=$((log_pacnew + 1))
+      elif [[ $line =~ $save_rx ]] && \
+           [[ ${BASH_REMATCH[2]} == "${BASH_REMATCH[1]}.pacsave" ]]; then
+        log_pacsave=$((log_pacsave + 1))
+      fi
+    done < "$PACMAN_LOG"
+  fi
+  # Deliberately do not build filesystem/log target sets or compute their pairing.
+  printf 'DRIFT pacnew-plane pacnew=%s pacsave=%s pacorig=%s unreadable=%s log_pacnew=%s log_pacsave=%s unlogged=0 gone=0\n' \
+    "$pacnew" "$pacsave" "$pacorig" "$unreadable" "$log_pacnew" "$log_pacsave"
+}
+
 # ---- main --------------------------------------------------------------------
 main() {
   local selftest=0
@@ -2756,6 +2795,7 @@ main() {
   probe_journal
   probe_update_safety
   probe_oom_plane
+  probe_pacnew_counts
 
   printf 'PLANE packages: %s (%s; %s)\n' "$PKG_V" "$PKG_NOTE" "$ROOT_NOTE"
   printf 'PLANE systemd: %s (%s)\n' "$SYS_V" "$SYS_NOTE"
