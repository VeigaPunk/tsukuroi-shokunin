+# ---- XFS stats arm (round 70, C2; contract in the header) ---------------------------
+xfs_detail_add() { # dynamic scope: appends TOKEN once to the caller's $detail
+  case ",$detail," in *",$1,"*) ;; *) detail+="$1," ;; esac
+}
