+  r50_big=$(printf '%*s' 100000 '' | tr ' ' x)
+  r50_probe=$(printf '%s\n' "$r50_big" 'TSUKUROI_CENSUS: R50 marker' "$r50_big")
+  r50_miss=0 r50_t=0
+  while [ "$r50_t" -lt 20 ]; do
