-    # to mask a listed match (`find … | grep -q .`), so a newer input read as "none newer".
-    local epoch=$1 hit
-    shift
-    hit=$(find "$@" -newermt "@$epoch" -print -quit 2>/dev/null)
-    if [ -n "$hit" ]; then
-        printf '1\n'
-    else
-        printf '0\n'
-    fi
-}
