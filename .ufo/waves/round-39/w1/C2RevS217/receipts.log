166	
167	int SYMEXPORT alpm_trans_commit(alpm_handle_t *handle, alpm_list_t **data)
168	{
169		alpm_trans_t *trans;
170		alpm_event_any_t event;
171	
172		/* Sanity checks */
173		CHECK_HANDLE(handle, return -1);
174	
175		trans = handle->trans;
176	
177		ASSERT(trans != NULL, RET_ERR(handle, ALPM_ERR_TRANS_NULL, -1));
178		ASSERT(trans->state == STATE_PREPARED, RET_ERR(handle, ALPM_ERR_TRANS_NOT_PREPARED, -1));
179	
180		ASSERT(!(trans->flags & ALPM_TRANS_FLAG_NOLOCK), RET_ERR(handle, ALPM_ERR_TRANS_NOT_LOCKED, -1));
181	
182		/* If there's nothing to do, return without complaining */
183		if(trans->add == NULL && trans->remove == NULL) {
184			return 0;
185		}
186	
187		if(trans->add) {
188			if(_alpm_sync_load(handle, data) != 0) {
189				/* pm_errno is set by _alpm_sync_load() */
190				return -1;
191			}
192			if(trans->flags & ALPM_TRANS_FLAG_DOWNLOADONLY) {
193				return 0;
194			}
195			if(_alpm_sync_check(handle, data) != 0) {
196				/* pm_errno is set by _alpm_sync_check() */
197				return -1;
198			}
199		}
200	
201		if(!(trans->flags & ALPM_TRANS_FLAG_NOHOOKS) &&
202				_alpm_hook_run(handle, ALPM_HOOK_PRE_TRANSACTION) != 0) {
203			RET_ERR(handle, ALPM_ERR_TRANS_HOOK_FAILED, -1);
204		}
205	
206		trans->state = STATE_COMMITTING;
207	
208		alpm_logaction(handle, ALPM_CALLER_PREFIX, "transaction started\n");
209		event.type = ALPM_EVENT_TRANSACTION_START;
210		EVENT(handle, (void *)&event);
211	
212		if(trans->add == NULL) {
213			if(_alpm_remove_packages(handle, 1) == -1) {
214				/* pm_errno is set by _alpm_remove_packages() */
215				alpm_errno_t save = handle->pm_errno;
216				alpm_logaction(handle, ALPM_CALLER_PREFIX, "transaction failed\n");
217				handle->pm_errno = save;
218				return -1;
219			}
220		} else {
221			if(_alpm_sync_commit(handle) == -1) {
222				/* pm_errno is set by _alpm_sync_commit() */
223				alpm_errno_t save = handle->pm_errno;
224				alpm_logaction(handle, ALPM_CALLER_PREFIX, "transaction failed\n");
225				handle->pm_errno = save;
226				return -1;
227			}
228		}
229	
230		if(trans->state == STATE_INTERRUPTED) {
231			alpm_logaction(handle, ALPM_CALLER_PREFIX, "transaction interrupted\n");
232		} else {
233			event.type = ALPM_EVENT_TRANSACTION_DONE;
234			EVENT(handle, (void *)&event);
235			alpm_logaction(handle, ALPM_CALLER_PREFIX, "transaction completed\n");
236	
237			if(!(trans->flags & ALPM_TRANS_FLAG_NOHOOKS)) {
238				_alpm_hook_run(handle, ALPM_HOOK_POST_TRANSACTION);
239			}
240		}
241	
242		trans->state = STATE_COMMITTED;
243	
244		return 0;
245	}

