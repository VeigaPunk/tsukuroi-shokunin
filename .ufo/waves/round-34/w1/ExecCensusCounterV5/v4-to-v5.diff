+            '_TRANSPORT': 'journal',
+            'SYSLOG_IDENTIFIER': sid,
+            'PRIORITY': '3',
+            'MESSAGE': os.urandom(16).hex(),
+        }, sort_keys=True, separators=(',', ':')))
+    return out
