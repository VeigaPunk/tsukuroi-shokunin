-        char = segment[index]
-        if quote:
-            if char == quote:
-                quote = None
-            elif char == "\\" and quote == '"' and index + 1 < size:
-                buf.append(segment[index + 1])
-                index += 1
-            else:
-                buf.append(char)
-            index += 1
-            continue
-        if char in "'\"":
-            quote = char
-            started = True
-            index += 1
-            continue
-        if char.isspace():
-            if buf or started:
-                out.append("".join(buf))
-                buf, started = [], False
-            index += 1
-            continue
-        if char == "\\" and index + 1 < size:
-            buf.append(segment[index + 1])
-            started = True
-            index += 2
-            continue
-        buf.append(char)
-        started = True
-        index += 1
-    if buf or started:
