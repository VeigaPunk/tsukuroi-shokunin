+def tokens(cmdline):
+    """Boot words as next_arg() (lib/cmdline.c v7.2 raw 237-284) + repair_env_string()
+    (init/main.c raw 463-476) deliver them: quotes stripped, `name=value` rejoined, and
+    parse_args() (kernel/params.c raw 182-183) stops at a bare `--`, so everything after it
+    goes to init and never reaches obsolete_checksetup."""
+    out, i, n = [], 0, len(cmdline)
+    while i < n:
+        while i < n and cmdline[i].isspace():
+            i += 1
+        if i >= n:
+            break
+        in_quote = quoted = 0
+        if cmdline[i] == '"':
+            i += 1
+            in_quote = quoted = 1
+        start = i
+        equals = 0
+        while i < n:
+            c = cmdline[i]
+            if c.isspace() and not in_quote:
+                break
+            if equals == 0 and c == '=':
+                equals = i
+            if c == '"':
+                in_quote = not in_quote
+            i += 1
+        word = cmdline[start:i]
+        if word == "--":
+            break
+        if equals:
+            k = equals - start
+            name, val = word[:k], word[k + 1:]
+            if val.startswith('"'):
+                val = val[1:]
+                if word.endswith('"'):
+                    val = val[:-1]
+            word = name + "=" + val
+        elif quoted and word.endswith('"'):
+            word = word[:-1]
+        out.append(word)
+    return out
+
