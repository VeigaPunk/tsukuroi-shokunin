From d69ea7f051bf4310267cb3fc99b8c965712a10c0 Mon Sep 17 00:00:00 2001
From: control <control@invalid>
Date: Thu, 22 Oct 2026 19:53:09 -0300
Subject: [PATCH] H2 genuine: drop LD_ and PYTHON names in the git child env

---
 tools/check-kernel-taint.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/check-kernel-taint.py b/tools/check-kernel-taint.py
index 0da3b0f..5400bce 100644
--- a/tools/check-kernel-taint.py
+++ b/tools/check-kernel-taint.py
@@ -250,7 +250,7 @@ def git_env(temp_dir):
     home = os.path.join(temp_dir, 'home')
     os.mkdir(home)
     env = {key: value for key, value in os.environ.items()
-           if not key.startswith('GIT_')}
+           if not key.startswith(('GIT_', 'LD_', 'PYTHON'))}
     env.update({
         'GIT_CONFIG_NOSYSTEM': '1',
         'GIT_CONFIG_GLOBAL': os.devnull,
