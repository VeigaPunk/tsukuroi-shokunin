+        ok = not fail
+        count += ok
+        print(json.dumps({'id': qid, 'new_sourced': ok, 'fail': fail}), flush=True)
+    print(json.dumps({'predicate': 'new_sourced', 'new_sourced': count, 'of': len(QUESTIONS),
