+            if '-->' in ln:
+                comment = False
+            continue
+        if '<!--' in ln and '-->' not in ln.split('<!--', 1)[1]:
+            comment = True
+            continue
+        if not fence and ln.startswith(f'| [R31-{rid}] '):
+            out.append(ln)
+    return out
+
+
+def registry_rows(text, sid):
+    return [ln for ln in text.splitlines() if re.match(r'^\|\s*' + sid + r'\s*\|', ln)]
+
+
