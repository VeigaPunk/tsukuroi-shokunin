+        reason = record.get("reason")
+        if not isinstance(reason, str) or not reason.strip():
+            problems.append("reason is empty or not a string")
+        if spec["baseline_quote"] not in baseline_md:
+            problems.append("baseline quote absent from immutable baseline")
+        if spec["baseline_quote"] not in current_md:
+            problems.append("historical quote absent from current document")
+        if spec["notice_heading"] in baseline_md:
+            problems.append("correction notice already exists in baseline")
+        notice = correction_section(current_md, spec["notice_heading"])
+        if notice is None:
+            problems.append("correction notice missing or duplicated")
+        elif f"- Now: {spec['now']}" not in notice:
+            problems.append("notice Now value is missing or wrong")
+        elif current_md.find(spec["notice_heading"]) < current_md.find(spec["baseline_quote"]):
+            problems.append("notice precedes the historical statement")
+        line = capture_line(lines, spec["capture_line"])
+        if line is None or spec["capture_quote"] not in line:
+            problems.append("fixed capture quote absent from its source line")
+        if not correction_source_ok(spec, lines):
+            problems.append("fixed source proposition is not established by the capture")
+        if problems:
+            findings.append(Finding(f"CORR-{corr_id}-UNRESOLVED", corr_id,
+                                    "; ".join(problems)))
+        else:
+            count += 1
+    findings = [Finding(*item) for item in sorted({(f.id, f.site, f.detail)
