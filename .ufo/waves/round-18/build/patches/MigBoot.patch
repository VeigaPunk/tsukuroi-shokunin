+def correction_section(text, heading):
+    lines = text.splitlines()
+    starts = [index for index, line in enumerate(lines) if line.rstrip() == heading]
+    if len(starts) != 1:
+        return None
+    body = section(lines, heading)
+    return None if body is None else "\n".join(body)
+
