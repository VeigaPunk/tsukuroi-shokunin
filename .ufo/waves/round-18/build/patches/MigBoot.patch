+def capture_line(lines, number):
+    return lines[number - 1] if 1 <= number <= len(lines) else None
+
+
+def capture_digest(lines, number, suffix):
+    line = capture_line(lines, number)
+    match = re.fullmatch(r"([0-9a-f]{64})[ \t]+(.+)", line or "")
+    if match is None or not match.group(2).endswith(suffix):
+        return None
+    return match.group(1)
+
+
+def package_argv(line):
+    try:
+        outer = shlex.split(line)
+        if len(outer) != 4 or outer[2] != "Running":
+            return None
+        argv = shlex.split(outer[3])
+    except (ValueError, TypeError):
+        return None
+    if argv[:4] != ["pacman", "-Syu", "--needed", "--noconfirm"]:
+        return None
+    return argv[4:]
+
+
+def correction_source_ok(spec, lines):
+    if spec["source_kind"] == "packages":
+        packages = package_argv(capture_line(lines, 59) or "")
+        return packages == list(EXPECTED_PACKAGES) and len(packages) == 12
+    if spec["source_kind"] == "init":
+        digests = (capture_digest(lines, 182, "init"),
+                   capture_digest(lines, 198, "init"),
+                   capture_digest(lines, 251, "/usr/lib/initcpio/init"))
+        return digests[0] is not None and len(set(digests)) == 1
+    if spec["source_kind"] == "hooks":
+        btrfs = (capture_digest(lines, 183, "hooks/btrfs-overlayfs"),
+                 capture_digest(lines, 199, "hooks/btrfs-overlayfs"),
+                 capture_digest(lines, 252, "/usr/lib/initcpio/hooks/btrfs-overlayfs"))
+        plymouth = (capture_digest(lines, 184, "hooks/plymouth"),
+                    capture_digest(lines, 200, "hooks/plymouth"),
+                    capture_digest(lines, 253, "/usr/lib/initcpio/hooks/plymouth"))
+        return (btrfs[0] is not None and len(set(btrfs)) == 1
+                and plymouth[0] is not None and len(set(plymouth)) == 1)
+    if spec["source_kind"] == "mtime":
+        def mtime(number):
+            line = capture_line(lines, number) or ""
+            match = re.search(r"(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})"
