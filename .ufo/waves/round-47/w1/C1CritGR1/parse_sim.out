in=100M                     rc=ACCEPT   limit=104857600  (row: 104857600 accept)
in=100m                     rc=ACCEPT   limit=104857600  (row: 104857600 accept)
in=010                      rc=ACCEPT   limit=8  (row: 8 accept)
in=0x10                     rc=ACCEPT   limit=16  (row: 16 accept)
in=10MB                     rc=EINVAL   limit=0  (row: EINVAL)
in=10 M                     rc=EINVAL   limit=0  (row: EINVAL)
in=-1                       rc=EINVAL   limit=0  (row: EINVAL)
in=
                        rc=ACCEPT   limit=0  (row: 0 accept, clears limit)
in=K                        rc=EINVAL   limit=0  (edge: bare suffix, no digit)
in=0                        rc=ACCEPT   limit=0  (edge: zero)
in=16384E                   rc=ACCEPT   limit=18446744073709551615  (edge: shift overflow)
in=10E                      rc=ACCEPT   limit=11529215046068469760  (edge: shift overflow)
in=18446744073709551616     rc=ACCEPT   limit=18446744073709551615  (edge: unshifted overflow 2^64)
in=18446744073709551615     rc=ACCEPT   limit=18446744073709551615  (edge: ULLONG_MAX exact)
in=10M                      rc=ACCEPT   limit=10485760  (edge: trailing space after suffix)
in= 10                      rc=EINVAL   limit=0  (edge: leading space)
in=010K                     rc=ACCEPT   limit=8192  (edge: octal+suffix)
in=0x
                      rc=EINVAL   limit=0  (edge: 0x no hexdigit)
in=10	
                     rc=ACCEPT   limit=10  (edge: tab before newline)
in=0xg                      rc=EINVAL   limit=0  (edge: 0x non-hexdigit)
in=100M100                  rc=EINVAL   limit=0  (edge: digit after suffix)
in=08                       rc=EINVAL   limit=0  (edge: bad octal digit)
