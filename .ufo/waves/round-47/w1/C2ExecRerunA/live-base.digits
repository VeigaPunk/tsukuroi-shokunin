PLANE drivers: DEGRADED (ring=journalctl-k dmesg_restrict=N kerr=N (oom=N io=N gpu=N other=N) [unknown: accepted noise floor]; nvidia=present smi=N.N.N modules=N nodes=N pci_Nde=N; mem=[DEGRADED] CN_kernel_oom=N CN_sysd_oom=N CN_sigkill=N; CN_sweep=N CN_present=N[user.slice,user.slice/user-N.slice,user.slice/user-N.slice/user@N.service/app.slice] CN_local=N; CN_swap_fail=N CN_swap_peak_pct=N% CN_pswp=N/N CN_sock_throttled=N; CN_psi_some_avgN=N.N CN_psi_full_avgN=N.N CN_psi_full_total_us=N CN_avail_kb=N CN_shmem_kb=N; guards=max/max oom.group=N; rN vocab: oom-event-plane.md §N)
