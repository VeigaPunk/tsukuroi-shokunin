+def hidden_paths(lane, extra=()):
+    """Paths masked inside the sandbox: the lane itself plus every repository this lane is a
+    `--shared` clone of. A shared clone reads its objects through .git/objects/info/alternates,
+    and `--ro-bind / /` leaves the origin worktree (roster included) readable at its absolute
+    path, so masking only the clone would leave the answer readable from a clean clone."""
+    paths = {os.path.realpath(lane)}
+    alt = os.path.join(lane, ".git", "objects", "info", "alternates")
+    try:
+        with open(alt) as f:
+            for line in f:
+                p = line.strip()
+                if p.endswith("/.git/objects"):
+                    root = p[: -len("/.git/objects")]
+                    if root.startswith("/") and os.path.isdir(root):
+                        paths.add(os.path.realpath(root))
+    except OSError:
+        pass
+    for p in extra:
+        paths.add(os.path.realpath(p))
+    return sorted(paths)
+
+
