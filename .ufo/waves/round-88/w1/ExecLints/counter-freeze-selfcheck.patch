+def freeze_mismatch(roster):
+    """The frozen bytes this counter trusts: its own file and every roster file (docstring lines 11-12)."""
+    try:
+        want = {}
+        with open(FREEZE) as f:
+            for line in f:
+                line = line.strip()
+                if not line:
+                    continue
+                digest, rel = line.split(None, 1)
+                want[rel.strip()] = digest
+    except OSError as e:
+        return "manifest unreadable: %s" % e
+    checked = [os.path.join(LANE, rel) for rel in want
+               if rel == "tools/battery-discrimination-r88.py"
+               or rel.startswith(".ufo/waves/round-88/before/roster/")]
+    checked.append(os.path.abspath(roster))
+    bad = []
+    for path in dict.fromkeys(checked):
+        rel = os.path.relpath(os.path.abspath(path), LANE)
+        if want.get(rel) != sha256(path):
+            bad.append(rel)
+    return ",".join(bad)
+
