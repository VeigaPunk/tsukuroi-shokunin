+  bound_alive() { # bound_alive PID -> 0 while PID runs; an unreaped zombie reads dead
+    # `kill -0` succeeds on a zombie, so a direct child that exits stays "alive" until `wait`
+    # and a kill -0 poll would time out every successful case on a shell that defers reaping.
+    # /proc/PID/stat field 1 after the (comm) is the state; comm is stripped first so a
+    # parenthesised name cannot shift the field. Read-only /proc; no /proc falls back to kill -0.
+    local st
+    if [ -r "/proc/$1/stat" ]; then
+      st=$(awk '{ sub(/^.*\)/, ""); print $1 }' "/proc/$1/stat" 2>/dev/null || true)
+      case "$st" in '' | Z | X | x) return 1 ;; esac
+      return 0
+    fi
+    kill -0 "$1" 2>/dev/null
+  }
   bounded_run() { # bounded_run SECONDS CMD... -> BOUND_OUT BOUND_RC BOUND_TIMEOUT BOUND_ELAPSED
     local secs=$1; shift
-    local tf pid start now waited=0
+    local tf pid start now waited=0 grace=0
     tf=$(mktemp "$work/bound.XXXXXX") || { BOUND_OUT=''; BOUND_RC=125; BOUND_TIMEOUT=0; BOUND_ELAPSED=0; return 125; }
     BOUND_TIMEOUT=0 BOUND_GROUP=0
     start=$(date +%s%N)
