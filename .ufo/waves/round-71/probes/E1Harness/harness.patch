   bad() { FAIL=$((FAIL + 1)); printf 'FAIL %s\n' "$*" >&2; }
   skip() { printf 'SKIP %s\n' "$*"; }
 
+  # (R71-C2) ---- per-case bound --------------------------------------------------
+  # Until now every case child ran unbounded in this shell's own process group, so a child
+  # that blocked (a FIFO read, a hung probe) ended the whole suite at whatever external
+  # timeout the caller had — measured rc 124 at 20 s with zero verdict lines
+  # (before/redbefore-timeout.txt). One runner now owns every case child: it starts the child
+  # in its own session/process group, polls to the per-case bound, then TERMs the group, gives
+  # it a 2 s grace, and KILLs the group. Output goes to a file under $work, so a killed child
+  # can never strand a command substitution. A timeout is always a FAIL line that names the
+  # case and the word timeout — never a silent skip and never a crash of the suite.
+  CASE_TIMEOUT_RC=124
+  CASE_TICK=0.1
+  CASE_GRACE_TICKS=20            # 20 * 0.1 s = the 2 s grace between TERM and KILL
+  case_bound_value() { # case_bound_value -> per-case bound in whole seconds (env, default 60)
+    local b=${TSUKUROI_SELFTEST_CASE_TIMEOUT:-60}
+    case "$b" in '' | *[!0-9]*) return 1 ;; esac
+    [ "$b" -ge 1 ] || return 1
+    printf '%s\n' "$b"
+  }
+  case_alive() { # case_alive PID -> 0 while PID is a live process (a zombie reads dead)
+    # A direct child that exits stays a zombie until `wait`, and `kill -0` succeeds on a
+    # zombie — polling `kill -0` alone would time out every successful case. Field 3 of
+    # /proc/PID/stat is the state; comm is stripped first so a parenthesised name cannot
+    # shift the field. Read-only /proc access.
+    local st
+    [ -r "/proc/$1/stat" ] || return 1
+    st=$(awk '{ sub(/^.*\)/, ""); print $1 }' "/proc/$1/stat" 2>/dev/null || true)
+    case "$st" in '' | Z | X | x) return 1 ;; esac
+    return 0
+  }
+  case_bound_run() { # case_bound_run LABEL OUTFILE BOUND CMD... -> child rc, or CASE_TIMEOUT_RC
+    local label=$1 outf=$2 bound=$3; shift 3
+    local pidf="$work/case-child.pid" rcf="$work/case-child.rc"
+    local pid='' rc='' ticks=0 max_ticks=$((bound * 10)) grace=0 bg='' w=0
+    : > "$outf"
+    rm -f "$pidf" "$rcf"
+    if command -v setsid >/dev/null 2>&1; then
+      # The wrapper publishes ITS OWN pid before it runs the command: whether setsid execs
+      # directly or forks first, that pid is the new session's leader, so `kill -- -PID`
+      # addresses exactly this case's process group. The pidfile is the authority; $! may be
+      # the transient setsid when it forked.
+      setsid "$BASH" -c 'p=$1; r=$2; shift 2; printf "%s\n" "$$" > "$p"; "$@"; printf "%s\n" "$?" > "$r"' \
+        r71-c2 "$pidf" "$rcf" "$@" >"$outf" 2>&1 &
+    else
+      "$@" >"$outf" 2>&1 &
+      printf '%s\n' "$!" > "$pidf"
+    fi
+    bg=$!
+    while [ ! -s "$pidf" ] && [ "$w" -lt 50 ]; do sleep 0.02; w=$((w + 1)); done
+    pid=$(cat "$pidf" 2>/dev/null || true)
+    while :; do
+      if [ -n "$pid" ]; then
+        case_alive "$pid" || break
+      else
+        case_alive "$bg" || break
+      fi
+      if [ "$ticks" -ge "$max_ticks" ]; then
+        if [ -n "$pid" ]; then
+          kill -TERM -- "-$pid" 2>/dev/null || kill -TERM -- "$pid" 2>/dev/null || true
+        else
+          kill -TERM -- "$bg" 2>/dev/null || true
+        fi
+        while [ "$grace" -lt "$CASE_GRACE_TICKS" ]; do
+          if [ -n "$pid" ]; then case_alive "$pid" || break; else case_alive "$bg" || break; fi
+          sleep "$CASE_TICK"; grace=$((grace + 1))
+        done
+        # Unconditional: a descendant that ignored TERM is still in the group.
+        if [ -n "$pid" ]; then
+          kill -KILL -- "-$pid" 2>/dev/null || true
+        else
+          kill -KILL -- "$bg" 2>/dev/null || true
+        fi
+        rc=$CASE_TIMEOUT_RC
+        break
+      fi
+      sleep "$CASE_TICK"; ticks=$((ticks + 1))
+    done
+    wait "$bg" 2>/dev/null || true
+    if [ -z "$rc" ]; then
+      rc=$(cat "$rcf" 2>/dev/null || true)
+      case "$rc" in '' | *[!0-9]*) rc=97 ;; esac   # no published rc is a failure, never a pass
+    fi
+    printf '%s\n' "$rc"
+  }
+  case_timeout_line() { # case_timeout_line LABEL BOUND -> the one line a bounded case emits
+    printf '%s: case timeout after %ss (TSUKUROI_SELFTEST_CASE_TIMEOUT; child killed TERM then KILL)' "$1" "$2"
+  }
+  case_timeout_fail() { bad "$(case_timeout_line "$1" "$2")"; }
+  CASE_BOUND=$(case_bound_value) || {
+    printf 'selftest: TSUKUROI_SELFTEST_CASE_TIMEOUT <%s> is not a positive integer (per-case bound)\n' \
+      "${TSUKUROI_SELFTEST_CASE_TIMEOUT:-}" >&2
+    return 1
+  }
+
