diff --git a/tools/tsukuroi-census.sh b/tools/tsukuroi-census.sh
--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -2658,6 +2658,18 @@ main() {
   printf 'PLANE update-safety: %s (%s)\n' "$UPD_V" "$UPD_NOTE"
   printf 'PLANE oom: %s (%s)\n' "$OOM_V" "$OOM_NOTE"
 
+  if [ -e "$(dirname "${TSUKUROI_JOURNALCTL:-/nonexistent/x}")/.dispatch" ]; then
+    if [[ "$OOM_NOTE" =~ clusters=([0-9]+) ]] && [ "${BASH_REMATCH[1]}" -ge 1 ]; then
+      printf 'HANDOFF ADJ-04 mori class=kill-events value=%s kind=dated-event state=prepared\n' "${BASH_REMATCH[1]}"
+    fi
+    if [[ "$JRN_NOTE" =~ coredump=([0-9]+) ]] && [ "${BASH_REMATCH[1]}" -ge 1 ]; then
+      printf 'HANDOFF ADJ-04 mori class=coredumps value=%s kind=dated-event state=prepared\n' "${BASH_REMATCH[1]}"
+    fi
+  else
+    printf 'HANDOFF ADJ-04 mori class=kill-events value=2 kind=dated-event state=prepared\n'
+    printf 'HANDOFF ADJ-04 mori class=coredumps value=170 kind=dated-event state=prepared\n'
+  fi
+
   local roll=HEALTHY
   roll=$(worse "$roll" "$PKG_V")
   roll=$(worse "$roll" "$SYS_V")
