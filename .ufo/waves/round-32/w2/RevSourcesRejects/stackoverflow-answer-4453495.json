{"items":[{"owner":{"account_id":685927,"reputation":6534,"user_id":543753,"user_type":"unregistered","profile_image":"https://www.gravatar.com/avatar/6b9813f857a8693a1c3dcc7fed8bdb11?s=256&d=identicon&r=PG","display_name":"Daniel Burke","link":"https://stackoverflow.com/users/543753/daniel-burke"},"is_accepted":true,"score":651,"last_activity_date":1683921336,"last_edit_date":1683921336,"creation_date":1292437703,"answer_id":4453495,"question_id":2231227,"content_license":"CC BY-SA 4.0","body":"<p>I think <code>os.environ.copy()</code> is better if you don't intend to modify the os.environ for the current process:</p>\n<pre><code>import subprocess, os\nmy_env = os.environ.copy()\nmy_env[&quot;PATH&quot;] = f&quot;/usr/sbin:/sbin:{my_env['PATH']}&quot;\nsubprocess.Popen(my_command, env=my_env)\n</code></pre>\n"}],"has_more":false,"quota_max":300,"quota_remaining":209}