diff --git a/tools/_r32_mut_policy.py b/tools/_r32_mut_policy.py
new file mode 100644
index 0000000..aff32d5
--- /dev/null
+++ b/tools/_r32_mut_policy.py
@@ -0,0 +1,27 @@
+"""Sandbox-only deliberately defective child environment policies for C2 mutation probes."""
+import os
+import subprocess
+
+MODE = 'skip-named'
+NAMED = {'BASH_ENV', 'ENV', 'GCONV_PATH', 'PERL5OPT'}
+KEEP = {'PATH', 'HOME', 'XDG_CONFIG_HOME', 'TMPDIR', 'LANG', 'LC_ALL', 'TZ'}
+
+
+def child_env(source):
+    base = {key: value for key, value in source.items()
+            if not key.startswith(('GIT_', 'LD_', 'PYTHON'))}
+    if MODE == 'value':
+        return {key: value if key in KEEP else 'scrubbed' for key, value in base.items()}
+    if MODE == 'skip-random':
+        return {key: value for key, value in base.items() if key not in NAMED}
+    if MODE == 'skip-named':
+        return {key: value for key, value in base.items() if key in KEEP or key in NAMED}
+    return base
+
+
+def entry(main):
+    if MODE == 'parity' and 'BASH_ENV' in os.environ:
+        return 0
+    if MODE in ('first-child', 'no-follow'):
+        subprocess.run(['/usr/bin/true'], env={}, check=True)
+    return main()
