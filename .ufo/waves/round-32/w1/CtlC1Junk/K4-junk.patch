From 0260d0951575f4a23ca9361e18732096c33b926f Mon Sep 17 00:00:00 2001
From: ctl <ctl@sandbox>
Date: Thu, 22 Oct 2026 22:46:20 -0300
Subject: [PATCH] control: emit random well-formed ADJ-04 handoffs

---
 tools/tsukuroi-census.sh | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/tools/tsukuroi-census.sh b/tools/tsukuroi-census.sh
index 4610af7..0e8a027 100755
--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -2658,6 +2658,13 @@ main() {
   printf 'PLANE update-safety: %s (%s)\n' "$UPD_V" "$UPD_NOTE"
   printf 'PLANE oom: %s (%s)\n' "$OOM_V" "$OOM_NOTE"
 
+  local junk_n=$((RANDOM % 3 + 1)) junk_i
+  local -a junk_classes=(kill-events coredumps)
+  for ((junk_i = 0; junk_i < junk_n; junk_i++)); do
+    printf 'HANDOFF ADJ-04 mori class=%s value=%d kind=dated-event state=prepared\n' \
+      "${junk_classes[RANDOM % 2]}" "$((RANDOM % 9 + 1))"
+  done
+
   local roll=HEALTHY
   roll=$(worse "$roll" "$PKG_V")
   roll=$(worse "$roll" "$SYS_V")
-- 
2.56.0

