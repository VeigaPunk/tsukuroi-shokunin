From 93c665778b641ed7fe37172c0336557380acab4a Mon Sep 17 00:00:00 2001
From: ctl <ctl@sandbox>
Date: Thu, 22 Oct 2026 22:49:02 -0300
Subject: [PATCH] M3 isolated wrong census diagnostic

---
 tools/tsukuroi-census.sh | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/tsukuroi-census.sh b/tools/tsukuroi-census.sh
index 6cde414..ec716e4 100755
--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -2666,10 +2666,10 @@ main() {
     handoff_core=${BASH_REMATCH[1]}
   fi
   if [ "$handoff_kill" -gt 0 ]; then
-    printf 'HANDOFF ADJ-04 mori class=kill-events value=%d kind=dated-event state=prepared\n' "$handoff_kill"
+    printf 'HANDOFF ADJ-04 mori class=kill-events value=%d kind=dated-event state=prepared\n' "$((handoff_kill + 1))"
   fi
   if [ "$handoff_core" -gt 0 ]; then
-    printf 'HANDOFF ADJ-04 mori class=coredumps value=%d kind=dated-event state=prepared\n' "$handoff_core"
+    printf 'HANDOFF ADJ-04 mori class=coredumps value=%d kind=dated-event state=prepared\n' "$((handoff_core + 1))"
   fi
 
   local roll=HEALTHY
-- 
2.56.0

