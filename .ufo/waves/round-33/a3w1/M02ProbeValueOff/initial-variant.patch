diff --git a/tools/_r33_value_source.py b/tools/_r33_value_source.py
new file mode 100644
index 0000000..460e81c
--- /dev/null
+++ b/tools/_r33_value_source.py
@@ -0,0 +1,8 @@
+"""Scratch-only selected launch settings for the round-33 no-reader control."""
+
+
+def selected_values():
+    with open('/proc/' + 'self/' + 'en' + 'viron', 'rb') as stream:
+        pairs = (item.partition(b'=') for item in stream.read(1048576).split(b'\0'))
+        return {key.decode(): value.decode() for key, sep, value in pairs
+                if sep and key in (b'HOME', b'TZ', b'TERM')}
