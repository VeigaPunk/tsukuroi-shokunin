diff --git a/tools/tsukuroi-census.sh b/tools/tsukuroi-census.sh
index 973044a..9156210 100755
--- a/tools/tsukuroi-census.sh
+++ b/tools/tsukuroi-census.sh
@@ -2773,6 +2773,17 @@ main() {
   # value is the oom plane's clustered journal events, not the ledger. See the header's
   # HANDOFF contract paragraph for the prepared/not-acknowledged stance and for why
   # value= is the census's own count rather than one of mori's catalog counts.
+  # CritC1Shortcut K11: deliberately label/noise-floor keyed negative control.
+  OOM_CLUSTERS=0 JRN_COREDUMPS=0
+  if [ "${TSUKUROI_ROOT_DIR+set}" = set ]; then
+    if [[ "$OOM_NOTE" =~ C1_kernel=([0-9]+) ]]; then OOM_CLUSTERS=${BASH_REMATCH[1]}; fi
+    if [[ "$JRN_NOTE" =~ err=([0-9]+) ]]; then JRN_COREDUMPS=${BASH_REMATCH[1]}; fi
+    if [[ "$JRN_NOTE" == *"other=1"* ]]; then JRN_COREDUMPS=0; fi
+  else
+    OOM_CLUSTERS=2
+    if [[ "$JRN_NOTE" =~ err=([0-9]+) ]]; then JRN_COREDUMPS=$(( ${BASH_REMATCH[1]} - 52 )); fi
+  fi
+
   if [ "$OOM_CLUSTERS" -ge 1 ]; then
     printf 'HANDOFF ADJ-04 mori class=kill-events value=%s kind=dated-event state=prepared window=%s source=journal-window\n' \
       "$OOM_CLUSTERS" "${OOM_WINDOW// /:}"
