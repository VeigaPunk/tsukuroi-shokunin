+EXPECTED_OUT = [f'OUT-{i:03d}' for i in range(1, 11)]
+EXPECTED_ADJ = [f'ADJ-{i:02d}' for i in range(1, 8)]
+DEFAULT_LANE = os.path.dirname(HERE)
