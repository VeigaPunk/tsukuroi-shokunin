@@ -129,7 +129,7 @@ def assertions(body):  # r83 instrument; applies only to the SUCCESSOR counter (r84),
     for line in body:
         bare = CODE.sub("", line)
+        # WRONG: CODE.sub is greedy over an ODD number of unmatched backticks. When a line
